                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"MTH-QUIZ1\",\n  \"subject_id\": \"MTH101\",\n  \"title\": \"Quiz 1 - Linear Algebra\",\n  \"max_score\": 30.0,\n  \"weight_percentage\": 20.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/assessments",
              "host": ["{{baseUrl}}"],
              "path": ["assessments"]
            }
          }
        },
        {
          "name": "List Assessments (GET /assessments)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/assessments",
              "host": ["{{baseUrl}}"],
              "path": ["assessments"]
            }
          }
        }
      ]
    },
    {
      "name": "Scores",
      "item": [
        {
          "name": "Record Student Score (POST /scores)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('created_score_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_id\": \"STD2026-0042\",\n  \"assessment_id\": \"MTH-QUIZ1\",\n  \"obtained_score\": 27.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/scores",
              "host": ["{{baseUrl}}"],
              "path": ["scores"]
            }
          }
        },
        {
          "name": "Update Score (PUT /scores/:score_id)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"obtained_score\": 29.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/scores/{{created_score_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["scores", "{{created_score_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Results & Analytics",
      "item": [
        {
