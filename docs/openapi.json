{
  "openapi": "3.1.0",
  "info": {
    "title": "Student Academic & Assessment Management API",
    "description": "\nA robust, secure RESTful API built with FastAPI for managing subjects, assessments, and student scores.\nFeatures:\n- **Pydantic Validation**: Strong request data models and types.\n- **Basic Authentication**: Secures write/admin routes.\n- **Clean REST Patterns & Predictable Status Codes**: 200, 201, 400, 401, 404, 422.\n- **Deep Service Architecture**: Clean separation between HTTP routing and academic business logic.\n    ",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/subjects": {
      "get": {
        "tags": [
          "Subjects"
        ],
        "summary": "List all Subjects",
        "operationId": "list_subjects_subjects_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SubjectResponse"
                  },
                  "type": "array",
                  "title": "Response List Subjects Subjects Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Subjects"
        ],
        "summary": "Create a new Subject",
        "operationId": "create_subject_subjects_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubjectCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubjectResponse"
                }
              }
            }
          },
          "400": {
            "description": "Subject already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/assessments": {
      "get": {
        "tags": [
          "Assessments"
        ],
        "summary": "List all Assessments",
        "operationId": "list_assessments_assessments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssessmentResponse"
                  },
                  "type": "array",
                  "title": "Response List Assessments Assessments Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Create a new Assessment",
        "operationId": "create_assessment_assessments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssessmentCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Duplicate ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Subject not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/scores": {
      "post": {
        "tags": [
          "Scores"
        ],
        "summary": "Record a student score",
        "operationId": "record_score_scores_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid score value or duplicate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Assessment not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ]
      }
    },
    "/scores/{score_id}": {
      "put": {
        "tags": [
          "Scores"
        ],
        "summary": "Update a recorded score",
        "operationId": "update_score_scores__score_id__put",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "score_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Score Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "400": {
            "description": "Score exceeds maximum allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Score record not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/students/{student_id}/results": {
      "get": {
        "tags": [
          "Results & Analytics"
        ],
        "summary": "Retrieve results and overall average for a specific student",
        "operationId": "get_student_results_students__student_id__results_get",
        "parameters": [
          {
            "name": "student_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Student Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentResultSummary"
                }
              }
            }
          },
          "404": {
            "description": "Student results not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/subjects/{subject_id}/average": {
      "get": {
        "tags": [
          "Results & Analytics"
        ],
        "summary": "Calculate average performance across all assessments in a subject",
        "operationId": "get_subject_average_subjects__subject_id__average_get",
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Subject Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Subject not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentCreate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 20,
            "minLength": 2,
            "title": "Id",
            "description": "Unique assessment code, e.g. QUIZ1, MIDTERM"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id",
            "description": "Subject code the assessment belongs to"
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Title",
            "description": "Assessment name"
          },
          "max_score": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Score",
            "description": "Maximum attainable score (0-100)"
          },
          "weight_percentage": {
            "type": "number",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Weight Percentage",
            "description": "Weight towards final grade (0-100%)"
          }
        },
        "type": "object",
        "required": [
          "id",
          "subject_id",
          "title",
          "max_score",
          "weight_percentage"
        ],
        "title": "AssessmentCreate"
      },
      "AssessmentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "max_score": {
            "type": "number",
            "title": "Max Score"
          },
          "weight_percentage": {
            "type": "number",
            "title": "Weight Percentage"
          }
        },
        "type": "object",
        "required": [
          "id",
          "subject_id",
          "title",
          "max_score",
          "weight_percentage"
        ],
        "title": "AssessmentResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Machine-readable error identifier"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable description of the error"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ScoreCreate": {
        "properties": {
          "student_id": {
            "type": "string",
            "maxLength": 20,
            "minLength": 3,
            "title": "Student Id",
            "description": "Student matriculation or admission number"
          },
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id",
            "description": "Assessment identifier"
          },
          "obtained_score": {
            "type": "number",
            "minimum": 0.0,
            "title": "Obtained Score",
            "description": "Score attained by student"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "assessment_id",
          "obtained_score"
        ],
        "title": "ScoreCreate"
      },
      "ScoreResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "subject_id": {
            "type": "string",
            "title": "Subject Id"
          },
          "obtained_score": {
            "type": "number",
            "title": "Obtained Score"
          },
          "max_score": {
            "type": "number",
            "title": "Max Score"
          },
          "percentage": {
            "type": "number",
            "title": "Percentage"
          },
          "grade": {
            "type": "string",
            "title": "Grade"
          }
        },
        "type": "object",
        "required": [
          "id",
          "student_id",
          "assessment_id",
          "subject_id",
          "obtained_score",
          "max_score",
          "percentage",
          "grade"
        ],
        "title": "ScoreResponse"
      },
      "ScoreUpdate": {
        "properties": {
          "obtained_score": {
            "type": "number",
            "minimum": 0.0,
            "title": "Obtained Score",
            "description": "Updated score attained by student"
          }
        },
        "type": "object",
        "required": [
          "obtained_score"
        ],
        "title": "ScoreUpdate"
      },
      "StudentResultSummary": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "total_assessments": {
            "type": "integer",
            "title": "Total Assessments"
          },
          "overall_average": {
            "type": "number",
            "title": "Overall Average"
          },
          "scores": {
            "items": {
              "$ref": "#/components/schemas/ScoreResponse"
            },
            "type": "array",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "student_id",
          "total_assessments",
          "overall_average",
          "scores"
        ],
        "title": "StudentResultSummary"
      },
      "SubjectCreate": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 10,
            "minLength": 2,
            "title": "Id",
            "description": "Unique subject code, e.g. MTH101"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "title": "Name",
            "description": "Subject title, e.g. Mathematics"
          },
          "credit_units": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Credit Units",
            "description": "Credit units (1 to 6)",
            "default": 3
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "SubjectCreate"
      },
      "SubjectResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "credit_units": {
            "type": "integer",
            "title": "Credit Units"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "credit_units"
        ],
        "title": "SubjectResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}